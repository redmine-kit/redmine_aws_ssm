# frozen_string_literal: true

# Loaded by Redmine's Gemfile. Nothing is added here: the plugin is added as a
# gem by path in Redmine's Gemfile.local (docs/README.md#installation), so
# that Bundler.require loads boot/redmine_aws_ssm.rb before the
# application's configuration. A path gem declared here would be written to
# Gemfile.lock relative to this directory and read back relative to Redmine's.
