#!/usr/bin/env bash
# Static checks: the newest RuboCop published at least 3 days ago, in Docker.
# No lock is committed; bundle update resolves the gems again on every run.
#   bin/lint                # on Ruby 4.0
#   TEST_RUBY=3.2 bin/lint  # on Ruby 3.2, as the CI also does
set -euo pipefail
cd "$(dirname "$0")/.."
# The Ruby image, pinned in test/ruby-<version>.Dockerfile (Dependabot
# updates it), with a bundle volume per Ruby version.
version=${TEST_RUBY:-4.0}
ruby=$(sed -n 's/^FROM //p' "test/ruby-$version.Dockerfile")
# Bundler 4 for --cooldown: Ruby 3.2 comes with Bundler 2.4.
docker run --rm -v "$PWD:/work" -w /work -v "redmine-aws-ssm-bundle-$version:/usr/local/bundle" \
  -e BUNDLE_GEMFILE=Gemfile.lint -e BUNDLER_VERSION=4.0.20 "$ruby" \
  sh -c 'gem install bundler -v "$BUNDLER_VERSION" --conservative --silent --no-document &&
    bundle update --quiet --cooldown=3 && bundle exec rubocop "$@"' rubocop "$@"
