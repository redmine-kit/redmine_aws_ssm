#!/usr/bin/env bash
# Tests (docs/setup.md#tests), in Apple container when it runs, else in
# Docker (CI; CONTAINER_CLI=container|docker chooses): the loader and a Rails
# application that boots with the plugin, against SSM on AWS Emulator
# (bin/aws_emulator). With COVERAGE set, the coverage of boot/ goes to
# coverage/ (Cobertura and HTML).
#   bin/test           # every test
#   bin/test --down    # stop the services
#   REDMINE_KIT_AWS_DIR=<dir> bin/test   # redmine_kit_aws from <dir> (default ../redmine_kit_aws)
#   TEST_RUBY=3.2 bin/test           # on Ruby 3.2 (default 4.0), as the CI also does
#   COVERAGE=1 bin/test              # with the coverage, as the CI does
# Commands that run inside containers are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/aws_emulator
name=redmine-kit-aws-ssm-test
if [[ "${1:-}" == --down ]]; then
  aws_emulator_down
  exit 0
fi
source bin/test_slot
trap 'release_test_slot; rm -rf "${aws_ca:-}"' EXIT
# The Ruby image, pinned in test/ruby-<version>.Dockerfile (Dependabot
# updates it), with a bundle volume per Ruby version.
version=${TEST_RUBY:-4.0}
ruby=$(sed -n 's/^FROM //p' "test/ruby-$version.Dockerfile")

# redmine_kit_aws, which the namespace test loads: a checkout next to this one,
# or REDMINE_KIT_AWS_DIR.
aws_dir=${REDMINE_KIT_AWS_DIR:-../redmine_kit_aws}
[[ -f "$aws_dir/init.rb" ]] || { echo "redmine_kit_aws is not in $aws_dir; set REDMINE_KIT_AWS_DIR" >&2; exit 1; }
aws_dir=$(cd "$aws_dir" && pwd)

stop_services_at_exit "$name"
aws_emulator_up
echo "SSM for the tests: AWS Emulator $emulator_version"
# The coverage of boot/ (test/coverage.rb) only with COVERAGE set.
cov=()
if [[ -n "${COVERAGE:-}" ]]; then
  rm -rf coverage
  cov=(-e PLUGIN_COVERAGE=1)
fi
gems=(-v "$PWD:/work" -w /work -v "$name-bundle-$version:/usr/local/bundle" -e BUNDLE_GEMFILE=Gemfile.test
  -v "$aws_dir:/redmine_kit_aws:ro" -e REDMINE_KIT_AWS_DIR=/redmine_kit_aws -e BUNDLER_VERSION=4.0.20)
# The gems first, on the default network (they come from rubygems.org), with
# Bundler 4 for --cooldown (Ruby 3.2 comes with Bundler 2.4).
"$cli" run --rm "${gems[@]}" "$ruby" sh -c '
  gem install bundler -v "$BUNDLER_VERSION" --conservative --silent --no-document &&
  bundle update --all --quiet --cooldown=3'
# Then the tests, on the emulator's network, which cannot reach AWS.
"$cli" run --rm "${gems[@]}" "${aws[@]}" \
  -e AWS_REGION=us-east-1 -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test \
  -e TEST_AWS_BACKEND=aws-emulator ${cov[@]+"${cov[@]}"} "$ruby" sh -c "$aws_forward"'
    bundle exec ruby -Iboot -e "Dir[\"test/*_test.rb\"].each { |file| require \"./#{file}\" }"'
